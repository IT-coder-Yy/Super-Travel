{
  "name": "supertravel-desktop",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "tools:dev": "node server/scripts/tools-dev.mjs",
    "web": "npm run web --workspace @supertravel/client --",
    "build": "npm run build --workspace @supertravel/client --",
    "preview": "npm run preview --workspace @supertravel/client --",
    "tauri": "npm run tauri --workspace @supertravel/client --",
    "test:ui": "npm run test:ui --workspace @supertravel/client --",
    "desktop:dev": "node scripts/desktop-build.mjs --dev",
    "desktop:build": "node scripts/desktop-build.mjs",
    "test:platform": "uv run --project server --locked python scripts/test-platform.py",
    "assets:prepare": "uv run --project server --locked python server/scripts/prepare-pdf-assets.py",
    "test:assets": "uv run --project server --locked python server/scripts/test-pdf-assets.py",
    "pretest:backend": "npm run assets:prepare",
    "test:backend": "uv run --project server --locked python -m pytest server/tests client/tests/native -q"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "client"
  ]
}
